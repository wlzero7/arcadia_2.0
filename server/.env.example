# Local development: leave Turso fields empty to use a local SQLite file.
PORT=3000
NODE_ENV=development
DB_PATH=./data/arcadia.db
JWT_SECRET=

# Render production: configure these privately, never in GitHub or chat.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set to 1 in Render, together with both Turso fields above.
REQUIRE_PERSISTENT_DB=0
# Recovery email: real values belong only in Render's private environment.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Arcadia
PUBLIC_ORIGIN=https://arcadia-780b.onrender.com
